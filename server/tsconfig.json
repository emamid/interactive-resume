{
	"compilerOptions": {
		"allowJs": true,
		"allowSyntheticDefaultImports": true,
		"baseUrl": "./",
		"emitDecoratorMetadata": true,
		"esModuleInterop": true,
		"experimentalDecorators": true,
		"lib": [
			"esnext",
			"dom"
		],
		"module": "commonjs",
		"moduleResolution": "node",
		"noImplicitAny": true,
		"outDir": "dist",
		"paths": {
			"@/*": [
				"./src/*"
			]
		},
		"resolveJsonModule": true,
		"rootDir": "src",
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": false,
		"target": "esnext",
		"typeRoots": [
			"./src/@types",
			"./node_modules/@types"
		]
	},
	"exclude": [
		"node_modules",
		"dist",
		"k8s",
		"old",
		"pg"
	],
	"include": [
		"src/**/*"
	]
}